#!/usr/bin/python3
"""Prepare management only; never change a console password. SPDX-License-Identifier: MIT."""
import ipaddress
import json
import os
from pathlib import Path
import re
import subprocess


def prepare():
    device = os.environ.get('MURUS_MANAGEMENT_INTERFACE', 'eth0')
    if not re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', device) or device == 'lo':
        raise ValueError('Invalid management interface')
    fallback = ipaddress.IPv4Interface(os.environ.get('MURUS_MANAGEMENT_FALLBACK', '192.168.56.1/24'))
    def run(*args):
        return subprocess.check_output(args, text=True, timeout=15)
    # Reject a missing port before generating credentials or changing network state.
    links=json.loads(run('ip', '-j', 'link', 'show', 'dev', device))
    if len(links) != 1:raise ValueError('Management interface is absent')
    run('ip', 'link', 'set', 'dev', device, 'up')
    addresses=json.loads(run('ip', '-j', '-4', 'addr', 'show', 'dev', device))
    if not any(item.get('addr_info') for item in addresses):
        run('ip', 'addr', 'add', str(fallback), 'dev', device)
    state=Path('/etc/murus_igneus')
    state.mkdir(mode=0o700, exist_ok=True)
    state.chmod(0o700)
    import sys
    sys.path.insert(0,'/usr/lib/murus-igneus')
    import authentication
    authentication.initialize_credentials(state)

if __name__ == '__main__':
    prepare()
